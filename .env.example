# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# UNIDAD 3: Web Services, APIs y Seguridad (Claves Protegidas)
# ========================================================
# IMPORTANTE: Este archivo .env.example es una plantilla pública y se sube a Git.
# El archivo real (.env) contiene los secretos privados y está ignorado en .gitignore
# para prevenir fugas de credenciales en GitHub.

# API Externa Gratuita: Películas y Series de Mortal Kombat (TMDb / OMDb)
VITE_TMDB_API_KEY="mk_tmdb_v3_public_key_secured"
REACT_APP_API_KEY="mk_omdb_v1_api_token_secured"
VITE_TMDB_BASE_URL="https://api.themoviedb.org/3"

# Configuración de Seguridad y Criptografía (Salt / Pepper para hashing seguro)
SECURITY_SALT_PEPPER="MK_SHA256_SALT_UNIDAD3_2026_MORTAL_KOMBAT"
VITE_JWT_SECRET="kombatpedia_realm_network_token_2026"
